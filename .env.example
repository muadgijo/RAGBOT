# LLM Backend: "groq" (for cloud deployment) or "ollama" (for local machine)
LLM_BACKEND=groq

# Groq Configuration (Required when LLM_BACKEND=groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b


# Ollama Configuration (Used when LLM_BACKEND=ollama)
OLLAMA_MODEL=phi3
OLLAMA_BASE_URL=http://localhost:11434

# Embedding Backend: "auto", "hf_api", "fastembed", or "local"
# "auto" uses Hugging Face Inference API if HF_TOKEN is provided, or fastembed if installed
EMBEDDING_BACKEND=auto

# Hugging Face Free User Access Token (Get for free at https://huggingface.co/settings/tokens)
HF_TOKEN=